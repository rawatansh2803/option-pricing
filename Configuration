import torch
import os

# Data parameters
n_trading_days = 500
n_strikes = 11
temporal_window = 20  # Height of the "image"
n_channels = 12       # Channels of the "image"
train_ratio = 0.8
val_ratio = 0.1
test_ratio = 0.1

# Model Architecture
conv_channels = [32, 64, 128]
fc_dims = [128, 64]
dropout = 0.15
use_se = True
se_reduction = 4
target_input_dim = 5  # [moneyness, tte, spot_norm, intrinsic_norm, log_moneyness]
target_embed_dim = 32
max_time_value_ratio = 0.25 # Sigmoid bound

# Training Hyperparameters
batch_size = 64
epochs = 50
learning_rate = 1e-3
weight_decay = 1e-4
loss_mse_weight = 0.5
loss_rel_weight = 0.5
loss_arbitrage_weight = 0.01

# Environment
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
output_dir = './checkpoints'
model_path = os.path.join(output_dir, 'final_weights.pth')

if not os.path.exists(output_dir):
    os.makedirs(output_dir)

feature_channels = [
    'close_norm', 'high_low_range', 'open_close_return', 'volume_norm',
    'oi_change', 'implied_vol', 'realised_vol', 'bid_ask_spread',
    'moneyness', 'log_moneyness', 'time_to_expiry', 'historical_premium'
]
